{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sylkit",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Keep variables set in the Cloudflare dashboard (payment keys) when deploying.
  "keep_vars": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  // Support inbox: tickets, messages and usage limits for the help widget (worker/support.js).
  "d1_databases": [
    { "binding": "SUPPORT_DB", "database_name": "sylkit-support", "database_id": "63757c0b-3235-4203-a1b7-36b73dc6a5cd" }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
